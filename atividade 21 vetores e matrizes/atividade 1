<!DOCTYPE html>
<html>
  <body>
    <script>
      let v = [];

      for (let i = 0; i < 5; i++) {
        v[i] = parseInt(prompt("Digite um número:"));
      }

      document.write("Ordem inversa:<br>");
      for (let i = 4; i >= 0; i--) {
        document.write(v[i] + "<br>");
      }
    </script>
  </body>
</html>
