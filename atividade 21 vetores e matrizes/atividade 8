<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Ex08</title>
  </head>
  <body>
    <script>
      let v = [];
      let somaP = 0,
        somaI = 0;
      let contP = 0,
        contI = 0;

      for (let i = 0; i < 5; i++) {
        v[i] = parseInt(prompt("Digite um número:"));

        if (v[i] % 2 === 0) {
          somaP += v[i];
          contP++;
        } else {
          somaI += v[i];
          contI++;
        }
      }

      let mediaP = contP > 0 ? somaP / contP : 0;
      let mediaI = contI > 0 ? somaI / contI : 0;

      document.write("Média dos pares: " + mediaP + "<br>");
      document.write("Média dos ímpares: " + mediaI);
    </script>
  </body>
</html>
