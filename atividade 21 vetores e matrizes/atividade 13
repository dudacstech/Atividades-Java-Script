<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Ex13</title>
  </head>
  <body>
    <script>
      let cont = 0;

      for (let i = 0; i < 10; i++) {
        let n = parseInt(prompt("Digite um número:"));

        if (n >= 10 && n <= 50) {
          cont++;
        }
      }

      document.write("Quantidade no intervalo [10,50]: " + cont);
    </script>
  </body>
</html>
