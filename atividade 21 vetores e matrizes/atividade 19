<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Ex19</title>
  </head>
  <body>
    <script>
      let a = [],
        b = [],
        c = [];

      for (let i = 0; i < 2; i++) {
        a[i] = [];
        b[i] = [];
        c[i] = [];

        for (let j = 0; j < 2; j++) {
          a[i][j] = parseInt(prompt("Matriz A:"));
          b[i][j] = parseInt(prompt("Matriz B:"));
          c[i][j] = a[i][j] + b[i][j];
        }
      }

      document.write("Resultado:<br>");
      for (let i = 0; i < 2; i++) {
        document.write(c[i][0] + " " + c[i][1] + "<br>");
      }
    </script>
  </body>
</html>
