<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Ex09</title>
  </head>
  <body>
    <script>
      let v = [];
      let pos = 0,
        neg = 0;

      for (let i = 0; i < 10; i++) {
        v[i] = parseInt(prompt("Digite um número:"));

        if (v[i] >= 0) {
          pos++;
        } else {
          neg++;
        }
      }

      document.write("Positivos: " + pos + "<br>");
      document.write("Negativos: " + neg);
    </script>
  </body>
</html>
